# AMM 容器镜像（Unraid 标准容器）
# ================================
# 与 Dockerfile.unraid 的区别：CUDA 组件**不再构建期下载 RPM**，
# 改为 COPY 本地组件包 cuda-bundle/。
# 原因：从 NVIDIA 源拉 158MB 的 cublas 反复 SSL 断流（exit 56），
#      构建十次九次失败。
#
# 组件包结构（cuda-bundle/，全部来自一台装好的 CUDA 13.2 环境）：
#   lib64/*.so*                cublas / cublasLt / nvblas / cudart（运行时）
#   include/*.h                cuda / cublas 头文件
#   bin/cicc                   nvvm 前端
#   nvvm-lib/*                 nvvm 运行库
#   nvcc-bin/*                 nvcc 编译器全家桶（nvcc/nvlink/ptxas/cudafe++/...）
#   targets-include/*          targets/x86_64-linux/include（nvcc 默认头文件搜索路径）
#   targets-lib/*.a            libcudart_static.a + libcudadevrt.a（nvcc 链接必需）
#   stubs/libcuda.so           driver stub（cmake 的 CUDA::cuda_driver 目标必需）
#
# 2026-11-18：补齐 nvcc-bin / targets-include / targets-lib。
# 此前镜像只有 CUDA **运行时**，没有编译器，导致在 Web 上装 llama.cpp 的
# cuda flavor 必然失败（先报找不到 nvcc，补装后又缺 libcudart_static 和
# cuda_runtime.h）。现在镜像自带完整工具链，装引擎开箱即用。
#
# 构建：
#   cp ../backend/requirements.txt ./requirements.txt
#   docker build -f Dockerfile.local-cuda -t amm:rocky9-cu132 .

FROM rockylinux:9

ENV LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Shanghai

# ---- 换国内源 ----
RUN set -eux; \
    sed -i -e "s|^mirrorlist=|#mirrorlist=|g" \
           -e "s|^#baseurl=http://dl.rockylinux.org/\$contentdir|baseurl=https://mirrors.aliyun.com/rockylinux|g" \
           /etc/yum.repos.d/rocky*.repo; \
    printf "[main]\nmax_parallel_downloads=8\nretries=20\ntimeout=120\nminrate=1\ninstall_weak_deps=False\n" > /etc/dnf/dnf.conf; \
    dnf clean all

# ---- 系统依赖 ----
# 注意：不装 curl（与 curl-minimal 冲突），gcc-toolset-12 用于 CUDA 13 编译
RUN set -eux; \
    dnf install -y \
        python3.11 python3.11-devel python3.11-pip \
        gcc gcc-c++ make cmake git wget tar xz bzip2 \
        gcc-toolset-12 gcc-toolset-12-gcc-c++ \
        openssh-server openssh-clients \
        procps-ng psmisc findutils which sudo \
        libgomp numactl-libs file \
    && dnf clean all

# ---- CUDA 运行时/编译组件（本地包，不下载）----
COPY cuda-bundle/lib64/    /usr/local/cuda-13.2/lib64/
COPY cuda-bundle/include/  /usr/local/cuda-13.2/include/
COPY cuda-bundle/bin/      /usr/local/cuda-13.2/nvvm/bin/
COPY cuda-bundle/nvvm-lib/ /usr/local/cuda-13.2/nvvm/lib64/

# nvcc 编译器本体（CUDA 构建 llama.cpp / vLLM 必需）
COPY cuda-bundle/nvcc-bin/       /usr/local/cuda-13.2/bin/
# nvcc 默认去 targets/x86_64-linux/{include,lib} 找头文件与库，
# 精简发行版只把文件放在 include/ 和 lib64/，这里补齐两处布局
COPY cuda-bundle/targets-include/ /usr/local/cuda-13.2/targets/x86_64-linux/include/
COPY cuda-bundle/targets-lib/     /usr/local/cuda-13.2/targets/x86_64-linux/lib/
# driver stub：cmake 里 CUDA::cuda_driver 找不到 libcuda.so 时直接
# "Target ggml-cuda links to: CUDA::cuda_driver" 报错，编译无法开始。
# 这是 stub（不含真实驱动逻辑），运行期靠 nvidia 运行时注入真库。
COPY cuda-bundle/stubs/           /usr/local/cuda-13.2/targets/x86_64-linux/lib/stubs/

RUN set -eux; \
    cd /usr/local/cuda-13.2/lib64; \
    # 补齐 .so / .so.N 两级链接（组件包只带真实版本文件）
    for f in libcublas libcublasLt libnvblas; do \
        if [ -f "${f}.so.13.4.1.3" ]; then \
            ln -sf "${f}.so.13.4.1.3" "${f}.so.13"; \
            ln -sf "${f}.so.13" "${f}.so"; \
        fi; \
    done; \
    # libcudart：llama.cpp 的 CUDA 构建必需（缺了会报 libcudart.so.13 not found）
    if [ -f libcudart.so.13.0.96 ]; then \
        ln -sf libcudart.so.13.0.96 libcudart.so.13; \
        ln -sf libcudart.so.13 libcudart.so; \
    fi; \
    # nvcc / nvrtc 等二进制与库若缺失，从 lib64 链接补齐
    chmod +x /usr/local/cuda-13.2/nvvm/bin/* 2>/dev/null || true; \
    chmod +x /usr/local/cuda-13.2/bin/* 2>/dev/null || true; \
    # nvcc 链接时在 targets/x86_64-linux/lib 找库，编译时在
    # targets/x86_64-linux/include 找头文件；精简包只放在 lib64/ 和 include/。
    # 这里把两个位置做成互链，任一种布局都能编译（缺了会报
    # cannot find -lcudart_static / -lcudadevrt 或 cuda_runtime.h not found）
    # 注意：此处 cwd 是 lib64，一律用绝对路径，否则 lib64/$f 会变成 lib64/lib64/
    C=/usr/local/cuda-13.2; \
    L=$C/targets/x86_64-linux/lib; \
    mkdir -p "$L"; \
    for f in libcudart_static.a libcudadevrt.a libcudart.so libcudart.so.13 libcudart.so.13.0.96 \
             libcublas.so libcublas.so.13 libcublas.so.13.4.1.3 \
             libcublasLt.so libcublasLt.so.13 libcublasLt.so.13.4.1.3 \
             libnvblas.so libnvblas.so.13 libnvblas.so.13.4.1.3; do \
        if [ -e "$L/$f" ] && [ ! -e "$C/lib64/$f" ]; then ln -sf "$L/$f" "$C/lib64/$f"; fi; \
        if [ -e "$C/lib64/$f" ] && [ ! -e "$L/$f" ]; then ln -sf "$C/lib64/$f" "$L/$f"; fi; \
    done; \
    # targets/include 下缺的条目，从 include/ 软链补齐
    TI=/usr/local/cuda-13.2/targets/x86_64-linux/include; \
    for d in /usr/local/cuda-13.2/include/*; do \
        b=$(basename "$d"); \
        if [ -d "$TI/$b" ] && [ -z "$(ls -A "$TI/$b" 2>/dev/null)" ]; then rmdir "$TI/$b"; fi; \
        [ -e "$TI/$b" ] || ln -sf "$d" "$TI/$b"; \
    done; \
    # 建 cuda 兼容入口
    ln -sfn /usr/local/cuda-13.2 /usr/local/cuda; \
    echo "/usr/local/cuda-13.2/lib64" > /etc/ld.so.conf.d/cuda.conf; \
    ldconfig

# 构建期自检：断裂在这层，而不是等用户点「安装引擎」才暴露
# 注意：用绝对路径调 nvcc —— ENV PATH 在这一层之后才生效
RUN set -eux; \
    NVCC=/usr/local/cuda-13.2/bin/nvcc; \
    $NVCC --version; \
    printf '__global__ void k(){}\nint main(){k<<<1,1>>>();return 0;}\n' > /tmp/t.cu; \
    $NVCC -o /tmp/t /tmp/t.cu; \
    ls -l /tmp/t; \
    rm -f /tmp/t /tmp/t.cu; \
    echo "CUDA toolchain self-test passed"

# ---- CCCL 头文件（cub / thrust / libcudacxx）----
# 若组件包里没有，构建时会跳过（llama.cpp 只在 CUDA 编译时需要）
RUN set -eux; \
    CC=/usr/local/cuda-13.2/targets/x86_64-linux/include/cccl; \
    mkdir -p "$CC"; \
    if [ -d /usr/local/cuda-13.2/include/cccl ]; then \
        cp -r /usr/local/cuda-13.2/include/cccl/* "$CC"/; \
    fi; \
    ls "$CC" || true

ENV CUDA_HOME=/usr/local/cuda-13.2 \
    PATH=/usr/local/cuda-13.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/usr/local/cuda-13.2/lib64

# ---- pip 国内源 + Python 依赖 ----
RUN mkdir -p /etc/pip && cat > /etc/pip.conf <<'PIPCFG'
[global]
index-url = https://mirrors.aliyun.com/pypi/simple/
[install]
trusted-host = mirrors.aliyun.com
PIPCFG

COPY requirements.txt /tmp/requirements.txt
RUN python3.11 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3.11 -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

RUN ssh-keygen -A && mkdir -p /run/sshd
WORKDIR /amm
EXPOSE 80 22

# 健康检查（配合 --restart unless-stopped 自愈）
HEALTHCHECK --interval=30s --timeout=6s --start-period=60s --retries=3 \
    CMD python3.11 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1/api/health', timeout=4).status==200 else 1)"

CMD ["/bin/bash", "/amm/deploy/docker-entrypoint.sh"]
