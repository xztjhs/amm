# AMM 运行环境变量配置
# ======================================
# 容器启动时会自动加载此文件中的环境变量
# 用法: source /amm/deploy/envs/amm.env

# 模型目录
export MODELS_DIR=/models
export AMM_ROOT=/amm

# HuggingFace / ModelScope 缓存目录
export HF_HOME=/models/huggingface
export HUGGINGFACE_HUB_CACHE=/models/huggingface
export MODELSCOPE_CACHE=/models/modelscope

# 推理引擎相关
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7  # 可用 GPU 列表，按实际调整
export CUDA_MODULE_LOADING=LAZY               # 延迟加载节省内存

# Python
export PYTHONUNBUFFERED=1
export PYTHONPATH=/amm/backend

# 日志
export LOG_LEVEL=INFO

# 网络
export AMM_HOST=0.0.0.0
export AMM_PORT=18080

# 性能
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
